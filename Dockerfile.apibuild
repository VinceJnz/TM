# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
ARG CLIENT_IMAGE
FROM ${CLIENT_IMAGE} AS client1-artifact

FROM golang:1.26.11-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS apibuilder
WORKDIR /app
COPY api-server/go.mod api-server/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY api-server/ ./
RUN --mount=type=cache,target=/go/pkg/mod go build -o /app/apiserver . && go build -o /app/tm-migrate ./cmd/migrate

FROM alpine:latest@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS runtime
RUN apk add --no-cache ca-certificates && \
    addgroup -g 10001 tm && adduser -D -u 10001 -G tm tm && \
    mkdir -p /etc/certs/ssl /etc/certs/gmail-tokens /etc/certs/gmail-credentials && \
    chown -R 10001:10001 /etc/certs/gmail-tokens
WORKDIR /app
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/VinceJnz/TM" org.opencontainers.image.revision=$SOURCE_REVISION
COPY --from=apibuilder /app/static/ ./static/
COPY --from=client1-artifact /out/main.wasm /out/wasm_exec.js ./static/
COPY --from=apibuilder /app/apiserver ./apiserver
COPY --from=apibuilder /app/tm-migrate ./tm-migrate
USER 10001:10001
EXPOSE 8085 8086

FROM runtime AS final
CMD ["./apiserver"]

FROM runtime AS interactive
CMD ["/bin/sh", "-c", "while :; do sleep 2073600; done"]

FROM apibuilder AS debug
ARG DELVE_VERSION=v1.27.2
RUN apk add --no-cache ca-certificates git && \
    GOBIN=/usr/local/bin go install github.com/go-delve/delve/cmd/dlv@${DELVE_VERSION} && \
    go build -gcflags='all=-N -l' -o /app/apiserver . && \
    addgroup -g 10001 tm && adduser -D -u 10001 -G tm tm && \
    mkdir -p /etc/certs/ssl /etc/certs/gmail-tokens /etc/certs/gmail-credentials && \
    chown -R 10001:10001 /etc/certs/gmail-tokens
COPY --from=client1-artifact /out/main.wasm /out/wasm_exec.js ./static/
USER 10001:10001
EXPOSE 8085 8086 40000
CMD ["dlv", "exec", "/app/apiserver", "--headless", "--listen=:40000", "--api-version=2", "--accept-multiclient"]
