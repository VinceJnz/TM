# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
ARG CLIENT_IMAGE=client1-built
ARG CLIENT_BUILDER=go-builder

FROM golang:1.26.11-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS go-builder
WORKDIR /app

COPY client1/go.mod client1/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY client1/ ./

RUN mkdir -p /tmp/client1-out

RUN --mount=type=cache,target=/go/pkg/mod \
    GOOS=js GOARCH=wasm go build -o /tmp/client1-out/main.wasm .
RUN cp "$(go env GOROOT)/lib/wasm/wasm_exec.js" /tmp/client1-out/wasm_exec.js


FROM tinygo/tinygo:0.40.0@sha256:920aea27ca83fe66e1173d9924b108651363f75a06b65c3b9428a62ed6f606e6 AS tinygo-builder

WORKDIR /app

COPY client1/go.mod client1/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY client1/ ./

RUN mkdir -p /tmp/client1-out
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/tinygo \
    tinygo build -o /tmp/client1-out/main.wasm -target wasm .
RUN cp /usr/local/tinygo/targets/wasm_exec.js /tmp/client1-out/wasm_exec.js


FROM ${CLIENT_BUILDER} AS selected


FROM scratch AS client1-built
COPY --from=selected /tmp/client1-out/ /out/

FROM ${CLIENT_IMAGE} AS client1-artifact

FROM golang:1.26.11-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS apibuilder
WORKDIR /app
COPY api-server/go.mod api-server/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY api-server/ ./
RUN --mount=type=cache,target=/go/pkg/mod go build -o /app/apiserver . && go build -o /app/tm-migrate ./cmd/migrate && go build -o /app/tm-healthcheck ./cmd/healthcheck && go build -o /app/tm-operations-check ./cmd/operations-check

FROM alpine:latest@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS runtime
RUN apk add --no-cache ca-certificates && \
    addgroup -g 10001 tm && adduser -D -u 10001 -G tm tm && \
    mkdir -p /etc/certs/ssl /etc/certs/gmail-tokens /etc/certs/gmail-credentials && \
    chown -R 10001:10001 /etc/certs/gmail-tokens
WORKDIR /app
ARG SOURCE_REVISION=unknown
ARG CLIENT_IMAGE
ARG CLIENT_BUILDER
LABEL org.tripmanager.client.image=$CLIENT_IMAGE
LABEL org.tripmanager.client.builder=$CLIENT_BUILDER
LABEL org.opencontainers.image.source="https://github.com/VinceJnz/TM" org.opencontainers.image.revision=$SOURCE_REVISION
COPY --from=apibuilder /app/static/ ./static/
COPY --from=client1-artifact /out/main.wasm /out/wasm_exec.js ./static/
COPY --from=apibuilder /app/apiserver ./apiserver
COPY --from=apibuilder /app/tm-migrate ./tm-migrate
COPY --from=apibuilder /app/tm-healthcheck ./tm-healthcheck
COPY --from=apibuilder /app/tm-operations-check ./tm-operations-check
USER 10001:10001
EXPOSE 8085 8086

FROM runtime AS final
HEALTHCHECK --interval=30s --timeout=4s --start-period=15s --retries=3 CMD ["/app/tm-healthcheck"]
CMD ["./apiserver"]

FROM runtime AS interactive
CMD ["/bin/sh", "-c", "while :; do sleep 2073600; done"]

FROM apibuilder AS debug
ARG DELVE_VERSION=v1.27.2
RUN apk add --no-cache ca-certificates git && \
    GOBIN=/usr/local/bin go install github.com/go-delve/delve/cmd/dlv@${DELVE_VERSION} && \
    go build -gcflags='all=-N -l' -o /app/apiserver . && \
    addgroup -g 10001 tm && adduser -D -u 10001 -G tm tm && \
    mkdir -p /etc/certs/ssl /etc/certs/gmail-tokens /etc/certs/gmail-credentials && \
    chown -R 10001:10001 /etc/certs/gmail-tokens
COPY --from=client1-artifact /out/main.wasm /out/wasm_exec.js ./static/
USER 10001:10001
EXPOSE 8085 8086 40000
CMD ["dlv", "exec", "/app/apiserver", "--headless", "--listen=:40000", "--api-version=2", "--accept-multiclient"]
