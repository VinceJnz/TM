# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG CLIENT_BUILDER=go-builder

FROM golang:1.26.11-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS go-builder
WORKDIR /app

COPY client1/go.mod client1/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY client1/ ./

RUN mkdir -p /tmp/client1-out

RUN --mount=type=cache,target=/go/pkg/mod \
    GOOS=js GOARCH=wasm go build -o /tmp/client1-out/main.wasm .
RUN cp "$(go env GOROOT)/lib/wasm/wasm_exec.js" /tmp/client1-out/wasm_exec.js
#RUN --mount=type=cache,target=/go/pkg/mod \
#    GOOS=js GOARCH=wasm go build -o /out/main.wasm .
#RUN cp "$(go env GOROOT)/lib/wasm/wasm_exec.js" /out/wasm_exec.js


#FROM tinygo/tinygo:latest AS wasmbuilder
#FROM tinygo/tinygo:0.41.1 AS tinygo-builder #(TinyGo 0.41.1: currently incompatible with this client’s net/http dependency.)
FROM tinygo/tinygo:0.40.0@sha256:920aea27ca83fe66e1173d9924b108651363f75a06b65c3b9428a62ed6f606e6 AS tinygo-builder

WORKDIR /app

COPY client1/go.mod client1/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY client1/ ./

RUN mkdir -p /tmp/client1-out
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/tinygo \
    tinygo build -no-debug -o /tmp/client1-out/main.wasm -target wasm .
RUN cp /usr/local/tinygo/targets/wasm_exec.js /tmp/client1-out/wasm_exec.js
#RUN --mount=type=cache,target=/go/pkg/mod \
#    --mount=type=cache,target=/root/.cache/tinygo \
#    tinygo build -o /out/main.wasm -target wasm .
#RUN cp /usr/local/tinygo/targets/wasm_exec.js /out/wasm_exec.js


FROM ${CLIENT_BUILDER} AS selected

FROM scratch AS artifact
ARG CLIENT_BUILDER
ARG SOURCE_REVISION=unknown
LABEL org.tripmanager.client.builder=$CLIENT_BUILDER
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
COPY --from=selected /tmp/client1-out/ /out/
#FROM scratch AS artifact
ARG CLIENT_BUILDER
ARG SOURCE_REVISION=unknown
LABEL org.tripmanager.client.builder=$CLIENT_BUILDER
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
#COPY --from=selected /out/ /out/
